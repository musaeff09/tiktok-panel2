<!DOCTYPE html>
<html lang="az">

<head>
    <!-- Analytics -->
    <script defer src="https://umami.tiktok-panel.xyz/script.js" data-website-id="350f90e9-946e-4d6e-8980-8f768edc4481"></script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Language" content="az" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#e50075" />

    <!-- Verification -->
    <meta name="google-site-verification" content="6a0UStkZHtcP5GR8XJv52o2gIi5h4lAzpbdSE4afi4U" />
    <meta name="msvalidate.01" content="16B13A896FAD3CC5AB0384ED4B6024C9" />

    <!-- SEO -->
    <title>Blog | TikTok və Instagram üçün faydalı məqalələr</title>
    <meta name="description"
        content="TikTok izləyici artırma, Instagram bəyənmə və SMM strategiyaları haqqında ən son məqalələr. Tiktok-panel.xyz blogu ilə hesabınızı düzgün böyüdün." />
    <meta name="keywords" content="TikTok blog, Instagram blog, SMM məqalələr, izləyici artırma, tiktok-panel" />
    <link rel="canonical" href="https://tiktok-panel.xyz/blog" />

    <meta name="author" content="tiktok-panel.xyz" />
    <meta name="geo.region" content="AZ-BAK" />
    <meta name="geo.placename" content="Baku" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tiktok-panel.xyz/blog" />
    <meta property="og:site_name" content="tiktok-panel.xyz" />
    <meta property="og:locale" content="az_AZ" />
    <meta property="og:title" content="Blog | TikTok və Instagram üçün faydalı məqalələr" />
    <meta property="og:description"
        content="SMM dünyasından xəbərlər, TikTok və Instagram-da böyümək üçün praktik bələdçilər." />
    <meta property="og:image" content="https://tiktok-panel.xyz/imgs/logo.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Blog | TikTok və Instagram üçün faydalı məqalələr" />
    <meta name="twitter:description"
        content="SMM dünyasından xəbərlər, TikTok və Instagram-da böyümək üçün praktik bələdçilər." />
    <meta name="twitter:image" content="https://tiktok-panel.xyz/imgs/logo.png" />

    <!-- Favicon -->
    <link rel="icon" href="/imgs/logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/imgs/logo.png" />

    <!-- Fonts & CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.6.0/remixicon.css"
        integrity="sha512-kJlvECunwXftkPwyvHbclArO8wszgBGisiLeuDFwNM8ws+wKIw0sv1os3ClWZOcrEB2eRXULYUsm8OVRGJKwGA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/css/style.css" />

    <!-- Structured Data: Blog -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Blog",
      "name": "Tiktok-Panel.xyz Blog",
      "url": "https://tiktok-panel.xyz/blog",
      "description": "TikTok, Instagram və digər sosial media platformaları üçün SMM məqalələri və bələdçilər.",
      "publisher": {
        "@type": "Organization",
        "name": "tiktok-panel.xyz",
        "url": "https://tiktok-panel.xyz/",
        "logo": {
          "@type": "ImageObject",
          "url": "https://tiktok-panel.xyz/imgs/logo.png"
        }
      }
    }
    </script>

    <!-- Structured Data: Breadcrumb -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Ana səhifə",
          "item": "https://tiktok-panel.xyz/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://tiktok-panel.xyz/blog"
        }
      ]
    }
    </script>
</head>

<body>
    <header class="header">
        <!-- Top Support Bar -->
        <div class="top-bar">
            <div class="container flex-between">
                <div class="contact-info">
                    <a href="mailto:support@tiktok-panel.xyz"><i class="ri-mail-line"></i> support@tiktok-panel.xyz</a>

                </div>
                <div class="site-info">
                    <a href="/about"><i class="ri-information-line"></i> Haqqımızda</a>
                    <a href="/contact"><i class="ri-customer-service-2-line"></i> Əlaqə</a>
                    <a href="/privacy"><i class="ri-shield-check-line"></i> Məxfilik</a>
                </div>
            </div>
        </div>

        <!-- Main Navigation -->
        <nav class="main-nav">
            <div class="container flex-between">
                <!-- 1. Logo -->
                <div class="logo">
                    <img src="imgs/logo.png" alt="logo">
                    <a href="/" class="logoText">Tiktok-<span>Panel.xyz</span></a>
                </div>

                <!-- 2. Menu & Mobile Toggle -->
                <div class="menu-wrapper">
                    <div class="search-toggle" id="mobile-menu-trigger">
                        <i class="ri-search-line"></i>
                    </div>

                    <div class="menu" id="nav-list">
                        <div class="menu-content">
                            <!-- Mobil üçün daxili axtarış (Yeni) -->
                            <div class="close-menu" id="close-menu-btn">
                                <i class="ri-close-line"></i>
                            </div>
                            <div class="mobile-search-area">
                                <div class="search-input-wrapper">
                                    <i class="ri-search-line"></i>
                                    <input type="text" placeholder="Platforma axtar...">
                                </div>
                                <div class="trending-searches">
                                    <p>Çox axtarılanlar:</p>
                                    <div class="tags">
                                        <span class="tag">TikTok</span>
                                        <span class="tag">Instagram</span>
                                        <span class="tag">YouTube</span>
                                    </div>
                                </div>
                                <div class="search-results-area">
                                    <!-- Nəticələr bura gələcək -->
                                    <p>Axtarış nəticəsi yoxdur...</p>
                                </div>
                            </div>

                            <!-- Əsas Linklər -->
                            <ul class="nav-links">
                                <li><a href="/"><i class="ri-home-4-line"></i> Ana Səhifə</a></li>
                                <li><a href="/platforms"><i class="ri-service-line"></i> Xidmətlər</a></li>
                                <li><a href="/blog" class="active"><i class="ri-news-line"></i> Blog</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Axtarış Bölməsi (Desktop) -->
                <div class="search-box-container">
                    <div class="search-box">
                        <input type="text" placeholder="Platforma axtar..." id="desktop-search">
                        <button><i class="ri-search-line"></i></button>
                    </div>
                    <!-- Axtarış nəticələri pəncərəsi -->
                    <div class="desktop-search-results" id="desktop-results">
                        <p class="search-title">Populyar Xidmətlər</p>
                        <div class="quick-links">
                            <a href="/tiktok">TikTok</a>
                            <a href="/instagram">Instagram</a>
                            <a href="/youtube">YouTube</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Mobile Bottom Navigation -->
        <div class="bottom-nav">
            <a href="/" class="bottom-item active">
                <i class="ri-home-4-line"></i>
                <span>Ana Səhifə</span>
            </a>
            <a href="/contact" class="bottom-item">
                <i class="ri-customer-service-2-line"></i>
                <span>Əlaqə</span>
            </a>
            <a href="/platforms" class="bottom-item circle-item">
                <i class="ri-service-line"></i>
                <br> <span>Xidmətlər</span>
            </a>
            <a href="/blog" class="bottom-item">
                <i class="ri-news-line"></i>
                <span>Blog</span>
            </a>
            <a href="/about" class="bottom-item">
                <i class="ri-information-line"></i>
                <span>Haqqımızda</span>
            </a>
        </div>
    </header>

    <!-- Page Header -->
    <section class="page-route-header">
        <div class="container">
            <div class="route-content">
                <nav class="breadcrumb-simple">
                    <a href="/">Ana Səhifə</a>
                    <i class="ri-arrow-right-s-line"></i>
                    <span class="current">Blog</span>
                </nav>

                <div class="page-info-center">
                    <div class="page-title">
                        <h2>Sosial Media <span>Blog</span></h2>
                        <p>Sosial mediada böyümək üçün məsləhətlər, yeniliklər və strategiyalar.</p>
                    </div>
                    <div class="platform-count-badge">
                        <i class="ri-article-line"></i>
                        <span>
                            <%= total %> məqalə
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Blog Section -->
    <section class="latest-blog">
        <div class="container">
            <% if (posts && posts.length> 0) { %>
                <div class="blog-grid">
                    <% posts.forEach(post=> { %>
                        <a href="/blog/<%= post.slug %>" class="blog-card">
                            <div class="blog-img">
                                <img src="<%= post.featured_image || 'imgs/blog01.webp' %>" alt="<%= post.title %>">
                                <span class="blog-category">
                                    <%= post.category %>
                                </span>
                            </div>
                            <div class="blog-info">
                                <div class="blog-meta">
                                    <span><i class="ri-calendar-line"></i>
                                        <%= new Date(post.created_at).toLocaleDateString('az-AZ', { day: 'numeric' ,
                                            month: 'long' , year: 'numeric' }) %>
                                    </span>
                                    <span><i class="ri-time-line"></i>
                                        <%= post.read_time %> dəq oxu
                                    </span>
                                </div>
                                <h3>
                                    <%= post.title %>
                                </h3>
                                <p>
                                    <%= post.excerpt || post.content.replace(/<[^>]*>/g, '').substring(0, 100) + '...'
                                        %>
                                </p>
                                <span class="read-more">Davamını oxu <i class="ri-arrow-right-line"></i></span>
                            </div>
                        </a>
                        <% }) %>
                </div>
                <% } else { %>
                    <div style="text-align: center; padding: 100px 20px;">
                        <i class="ri-file-list-3-line" style="font-size: 80px; color: #333;"></i>
                        <p style="color: #666; font-size: 18px; margin-top: 20px;">Hələ məqalə yoxdur</p>
                    </div>
                    <% } %>

                        <!-- Pagination -->
                        <% if (totalPages> 1) { %>
                            <div class="blog-pagination">
                                <!-- Geri -->
                                <a href="/blog?page=<%= currentPage > 1 ? currentPage - 1 : 1 %>"
                                    class="page-btn <%= currentPage === 1 ? 'disabled' : '' %>">
                                    <i class="ri-arrow-left-s-line"></i>
                                </a>

                                <!-- Səhifə nömrələri -->
                                <% for(let i=1; i <=totalPages; i++) { %>
                                    <% if (totalPages <=7 || i===1 || i===totalPages || Math.abs(i - currentPage) <=1) {
                                        %>
                                        <a href="/blog?page=<%= i %>"
                                            class="page-btn <%= i === currentPage ? 'active' : '' %>">
                                            <%= i %>
                                        </a>
                                        <% } else if (i===2 && currentPage> 3) { %>
                                            <span class="page-dots">...</span>
                                            <% } else if (i===totalPages - 1 && currentPage < totalPages - 2) { %>
                                                <span class="page-dots">...</span>
                                                <% } %>
                                                    <% } %>

                                                        <!-- İrəli -->
                                                        <a href="/blog?page=<%= currentPage < totalPages ? currentPage + 1 : totalPages %>"
                                                            class="page-btn <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                            <i class="ri-arrow-right-s-line"></i>
                                                        </a>
                            </div>
                            <% } %>
        </div>
    </section>

    <!-- Footer Start -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <!-- 1. Logo + About -->
                <div class="footer-col">
                    <div class="footer-logo">
                        <img src="imgs/logo.png" alt="logo">
                        <a href="/" class="logoText">Tiktok-<span>Panel.xyz</span></a>
                    </div>
                    <p class="footer-desc">
                        Azərbaycanda ən sürətli və etibarlı sosial media xidmətləri. TikTok, Instagram, YouTube üçün
                        keyfiyyətli izləyici, bəyənmə və baxış.
                    </p>
                    <div class="footer-socials">
                        <a href="https://www.instagram.com/tiktok_panelcom/" aria-label="Instagram"><i
                                class="ri-instagram-line"></i></a>
                        <a href="https://www.tiktok.com/@tiktok_panel.com" aria-label="TikTok"><i
                                class="ri-tiktok-fill"></i></a>
                    </div>
                </div>

                <!-- 2. Sürətli Keçidlər -->
                <div class="footer-col">
                    <h4 class="footer-title">Sürətli Keçidlər</h4>
                    <ul class="footer-links">
                        <li><a href="/about"><i class="ri-arrow-right-s-line"></i> Haqqımızda</a></li>
                        <li><a href="/platforms"><i class="ri-arrow-right-s-line"></i> Xidmətlər</a></li>
                        <li><a href="/contact"><i class="ri-arrow-right-s-line"></i> Əlaqə</a></li>
                        <li><a href="/blog"><i class="ri-arrow-right-s-line"></i> Bloq</a></li>
                    </ul>
                </div>

                <!-- 3. Xidmətlər -->
                <div class="footer-col">
                    <h4 class="footer-title">Populyar Platformalar</h4>
                    <ul class="footer-links">
                        <li><a href="/tiktok"><i class="ri-arrow-right-s-line"></i> TikTok</a></li>
                        <li><a href="/instagram"><i class="ri-arrow-right-s-line"></i> Instagram</a></li>
                        <li><a href="/youtube"><i class="ri-arrow-right-s-line"></i> YouTube</a></li>
                        <li><a href="/telegram"><i class="ri-arrow-right-s-line"></i> Telegram</a></li>
                        <li><a href="/platforms"><i class="ri-arrow-right-s-line"></i> Bütün Xidmətlər</a></li>
                    </ul>
                </div>

                <!-- 4. Əlaqə -->
                <div class="footer-col">
                    <h4 class="footer-title">Əlaqə Saxla</h4>
                    <ul class="footer-contact">
                        <li>
                            <i class="ri-mail-send-line"></i>
                            <div>
                                <span>Email</span>
                                <a href="mailto:support@tiktok-panel.xyz">support@tiktok-panel.xyz</a>
                            </div>
                        </li>
                        <li>
                            <i class="ri-time-line"></i>
                            <div>
                                <span>İş saatları</span>
                                <p>24/7 Dəstək</p>
                            </div>
                        </li>
                        <li>
                            <i class="ri-customer-service-2-fill"></i>
                            <div>
                                <span>Canlı Dəstək</span>
                                <a href="/contact">Dəstək bölməsi</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="footer-bottom">
            <div class="container flex-between">
                <p class="copyright">
                    © 2026 Tiktok-Panel.xyz — Bütün hüquqlar qorunur.
                </p>
                <div class="footer-bottom-links">
                    <a href="/privacy">Məxfilik Siyasəti</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="/js/script.js"></script>
</body>

</html>
