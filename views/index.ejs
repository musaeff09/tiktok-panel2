                <p>İstifadəçilərin ən çox seçdiyi paketlər. Sifariş anında başlayır.</p>
            </div>

            <div class="service-tabs">
                <% if (services && services.length) { %>
                    <% services.forEach((service, index)=> { %>
                        <button class="s-tab-btn <%= index === 0 ? 'active' : '' %>"
                            data-platform="<%= service.platform %>">
                            <i
                                class="ri-<%= service.platform === 'tiktok' ? 'tiktok-fill' : service.platform + '-line' %>"></i>
                            <%= service.platform.charAt(0).toUpperCase() + service.platform.slice(1) %>
                        </button>
                        <% }) %>
                            <% } %>
            </div>

            <div class="services-container">
                <% if (services && services.length) { %>
                    <% services.forEach((service, index)=> { %>
                        <div class="services-grid <%= index === 0 ? 'active' : '' %>"
                            data-platform="<%= service.platform %>">
                            <% service.items.forEach(item=> { %>
                                <div class="compact-service-card">
                                    <div class="card-left">
                                        <div class="p-icon">
                                            <i
                                                class="ri-<%= service.platform === 'tiktok' ? 'tiktok-fill' : service.platform + '-line' %>"></i>
                                        </div>
                                        <div class="p-info">
                                            <h4>
                                                <%= item.name %>
                                            </h4>
                                            <span class="p-price">
                                                <%= Number(item.price).toFixed(2) %> ₼
                                            </span>
                                        </div>
                                    </div> <!-- BAX BU DIV ƏSKİK İDİ -->
                                    <div class="card-right">
                                        <a href="<%= item.link || `/checkout?service=${item.id}` %>"
                                            class="buy-btn">Al</a>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                        <% }) %>
                            <% } %>
            </div>
        </div>
    </section>

